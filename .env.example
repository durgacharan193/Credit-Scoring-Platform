# ============================================================
# Alternative Credit Scoring Platform — Environment Variables
# Copy this file to .env and fill in the values before running.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://credituser:creditpass@localhost:5432/creditdb?schema=public

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── RabbitMQ ─────────────────────────────────────────────────
RABBITMQ_URL=amqp://credituser:creditpass@localhost:5672
RABBITMQ_DEFAULT_USER=credituser
RABBITMQ_DEFAULT_PASS=creditpass

# ── Authentication ───────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=change_me_to_a_strong_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ── OTP Settings ─────────────────────────────────────────────
OTP_TTL_SECONDS=600

# ── Backend Service ──────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Frontend (Next.js) ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_TELEMETRY_DISABLED=1

# ── AWS Configuration ────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ── ECR (Elastic Container Registry) ────────────────────────
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
ECR_BACKEND_REPO=credit-backend
ECR_FRONTEND_REPO=credit-frontend
ECR_SCORING_REPO=credit-scoring

# ── ECS Cluster ──────────────────────────────────────────────
ECS_CLUSTER=credit-scoring-production
ECS_BACKEND_SERVICE=credit-backend-service
ECS_FRONTEND_SERVICE=credit-frontend-service
ECS_SCORING_SERVICE=credit-scoring-service

# ── RDS (Production) ─────────────────────────────────────────
# Set by Terraform output; override for direct connections
# RDS_HOST=credit-scoring-db.xxxxxxxx.us-east-1.rds.amazonaws.com
# RDS_PORT=5432
# RDS_DB=creditdb
# RDS_USER=credituser
# RDS_PASSWORD=change_me_strong_rds_password

# ── Scoring Service ──────────────────────────────────────────
SCORING_SERVICE_URL=http://localhost:8000
SCORING_API_KEY=change_me_scoring_api_key

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
# Options: error | warn | info | http | verbose | debug | silly

# ── Terraform (for infra management) ─────────────────────────
TF_VAR_db_password=change_me_strong_rds_password
TF_VAR_rabbitmq_password=change_me_strong_mq_password
TF_VAR_jwt_secret=change_me_to_a_strong_random_secret_at_least_64_chars
